# URL pública da API (acessada pelo browser/cliente)
NEXT_PUBLIC_API_URL="http://localhost:3000"

# URL interna da API (acessada por Server Components / Server Actions)
# Em produção, usar URL interna do Fly; em dev, mesma do public.
API_URL="http://localhost:3000"

# Toggle: quando true, lib/api/endpoints/* retorna mocks; quando false, chama a API real
USE_MOCK="true"
